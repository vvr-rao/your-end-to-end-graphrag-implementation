{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(./.env)",
      "Read(**/.env)",
      "Read(.env.local)",
      "Read(.env.*.local)",
      "Read(.env.bak*)",
      "Read(.env-bak*)",
      "Read(.env.backup)",
      "Read(.env-backup)",
      "Bash(cat .env)",
      "Bash(cat ./.env)",
      "Bash(cat *.env)",
      "Bash(head .env)",
      "Bash(head ./.env)",
      "Bash(tail .env)",
      "Bash(tail ./.env)",
      "Bash(less .env)",
      "Bash(more .env)",
      "Bash(nl .env)",
      "Bash(xxd .env)",
      "Bash(od .env)",
      "Bash(strings .env)",
      "Bash(printenv *)",
      "Bash(env)",
      "Bash(grep * .env)",
      "Bash(grep * ./.env)",
      "Bash(egrep * .env)",
      "Bash(fgrep * .env)",
      "Bash(rg * .env)",
      "Bash(rg * ./.env)",
      "Bash(awk * .env)",
      "Bash(awk * ./.env)",
      "Bash(sed * .env)",
      "Bash(sed * ./.env)",
      "Bash(sort .env)",
      "Bash(sort * .env)",
      "Bash(cut * .env)",
      "Bash(tac .env)",
      "Bash(tac ./.env)",
      "Bash(rev .env)",
      "Bash(paste .env)",
      "Bash(dd *.env*)",
      "Bash(bat .env)",
      "Bash(hexdump *.env*)",
      "Bash(cp .env *)",
      "Bash(cp ./.env *)",
      "Bash(mv .env *)",
      "Bash(python -c *.env*)",
      "Bash(python3 -c *.env*)",
      "Bash(uv run python -c *.env*)",
      "Bash(uv run python3 -c *.env*)",
      "Bash(perl -e *.env*)",
      "Bash(perl -n *.env*)",
      "Bash(ruby -e *.env*)",
      "Bash(node -e *.env*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run python scripts/build_state.py show --quiet-if-empty"
          }
        ]
      }
    ]
  }
}
