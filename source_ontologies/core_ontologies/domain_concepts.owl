<?xml version="1.0"?>
<!--
    Bootstrap "bucket" classes for the Stage 2 LLM to anchor against.

    The Stage 2 LLM, when proposing new classes, tends to use abstract
    parent labels like "Industry", "EconomicConcept", "Event", "Material"
    etc. Without these classes pre-existing in the merged ontology, the
    chain rule in `add_new_classes_from_match_not_found` synthesizes
    them as orphans (parent = owl:Thing), inflating Layer G's orphan
    count by thousands.

    Each bucket is dual-typed: owl:Class AND skos:Concept (OWL Punning,
    legal in OWL 2 DL). The OWL side keeps the pipeline's existing
    classes_dict handling unchanged. The SKOS side makes the buckets
    SPARQL- and tool-friendly as a navigable concept scheme.

    The buckets are organized under a single skos:ConceptScheme
    (DomainConceptsScheme) so they can be browsed as a top-level facet.

    Namespace: https://veerla-ramrao.ai/ontology/domain-concepts#
    Protected via the umbrella https://veerla-ramrao.ai/ontology/
    prefix in config.yaml.
-->
<rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:skos="http://www.w3.org/2004/02/skos/core#"
    xmlns:xml="http://www.w3.org/XML/1998/namespace"
    xmlns="https://veerla-ramrao.ai/ontology/domain-concepts#">

    <owl:Ontology rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts">
        <rdfs:label>Domain Concepts (bootstrap buckets)</rdfs:label>
        <rdfs:comment>Top-level bucket classes that anchor newly-minted concept classes in the prune-expand pipeline. Each class is dual-typed as owl:Class (for OWL inference + classes_dict handling) and skos:Concept (for thesaurus-style navigation). Maintained by the curator.</rdfs:comment>
    </owl:Ontology>

    <!-- ConceptScheme grouping all bootstrap buckets as top concepts. -->
    <skos:ConceptScheme rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme">
        <rdfs:label>Domain Concepts Scheme</rdfs:label>
        <skos:prefLabel xml:lang="en">Domain Concepts</skos:prefLabel>
        <skos:definition>A top-level concept scheme for organizing newly-minted concept classes by abstract domain.</skos:definition>
        <skos:hasTopConcept rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#Industry"/>
        <skos:hasTopConcept rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#EconomicConcept"/>
        <skos:hasTopConcept rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#PolicyConcept"/>
        <skos:hasTopConcept rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#Event"/>
        <skos:hasTopConcept rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#Process"/>
        <skos:hasTopConcept rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#Material"/>
        <skos:hasTopConcept rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#NaturalResource"/>
        <skos:hasTopConcept rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#TechnologyConcept"/>
        <skos:hasTopConcept rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#Infrastructure"/>
        <skos:hasTopConcept rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#SupplyChainConcept"/>
        <skos:hasTopConcept rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#GeographicFeature"/>
        <skos:hasTopConcept rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConcept"/>
        <skos:hasTopConcept rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#FinancialTable"/>
        <skos:hasTopConcept rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#FinancialObservation"/>
        <skos:hasTopConcept rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#Metric"/>
        <skos:hasTopConcept rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#Dimension"/>
        <skos:hasTopConcept rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#Measure"/>
        <skos:hasTopConcept rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#TimePeriod"/>
        <skos:hasTopConcept rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#Quantity"/>
        <skos:hasTopConcept rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#Condition"/>
        <skos:hasTopConcept rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#Method"/>
        <skos:hasTopConcept rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#Intervention"/>
        <skos:hasTopConcept rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#Outcome"/>
    </skos:ConceptScheme>

    <!-- 1. Industry -->
    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#Industry">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>Industry</rdfs:label>
        <skos:prefLabel xml:lang="en">Industry</skos:prefLabel>
        <rdfs:comment>A kind of human economic activity. Examples: Agriculture, Manufacturing, Mining, Healthcare, Energy, Transportation, Finance.</rdfs:comment>
        <skos:definition>A kind of human economic activity (sector / branch of the economy).</skos:definition>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
    </owl:Class>

    <!-- 2. EconomicConcept -->
    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#EconomicConcept">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>EconomicConcept</rdfs:label>
        <skos:prefLabel xml:lang="en">Economic Concept</skos:prefLabel>
        <rdfs:comment>A market or financial phenomenon. Examples: Price, Demand, Subsidy, Tariff, Inflation, Recession.</rdfs:comment>
        <skos:definition>A market, monetary, or financial phenomenon.</skos:definition>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
    </owl:Class>

    <!-- 3. PolicyConcept -->
    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#PolicyConcept">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>PolicyConcept</rdfs:label>
        <skos:prefLabel xml:lang="en">Policy Concept</skos:prefLabel>
        <rdfs:comment>A kind of rule, standard, framework or governance instrument. Examples: boxed warning, FDA approval, clinical guideline (pharma); IFRS rule, loan covenant, capital requirement (finance); ISO standard, safety regulation (manufacturing); law, treaty, sanction, tariff (general).</rdfs:comment>
        <skos:definition>A rule, regulation, treaty, or framework imposed by governments or institutions.</skos:definition>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
    </owl:Class>

    <!-- 4. Event -->
    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#Event">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>Event</rdfs:label>
        <skos:prefLabel xml:lang="en">Event</skos:prefLabel>
        <rdfs:comment>A named happening with a time signature. Examples: Iran-Israel war, Hormuz closure, Helium crisis, COVID-19 pandemic, Suez Canal blockage.</rdfs:comment>
        <skos:definition>A named happening (war, crisis, closure, summit, attack, treaty signing, etc.).</skos:definition>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
    </owl:Class>

    <!-- 5. Process -->
    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#Process">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>Process</rdfs:label>
        <skos:prefLabel xml:lang="en">Process</skos:prefLabel>
        <rdfs:comment>A kind of activity or series of steps that unfolds over time, in any domain. Examples: clinical trial, drug absorption, metabolism (pharma); audit, refinancing, consolidation (finance); assembly, curing, refining, machining (manufacturing); decarbonization, migration (general).</rdfs:comment>
        <skos:definition>A named ongoing activity (operational, industrial, or natural).</skos:definition>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
    </owl:Class>

    <!-- 6. Material -->
    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#Material">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>Material</rdfs:label>
        <skos:prefLabel xml:lang="en">Material</skos:prefLabel>
        <rdfs:comment>A kind of physical substance, compound, or commodity. Examples: active ingredient, excipient, insulin (pharma); commodity, gold (finance); steel, resin, lithium, polymer (manufacturing); water, helium, urea (general).</rdfs:comment>
        <skos:definition>A physical substance, chemical, or compound.</skos:definition>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
    </owl:Class>

    <!-- 7. NaturalResource -->
    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#NaturalResource">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#Material"/>
        <rdfs:label>NaturalResource</rdfs:label>
        <skos:prefLabel xml:lang="en">Natural Resource</skos:prefLabel>
        <rdfs:comment>An extracted natural input. Examples: Crude Oil, Natural Gas, Ore, Timber, Phosphate Rock.</rdfs:comment>
        <skos:definition>A naturally-occurring material extracted from the environment as an industrial input.</skos:definition>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
        <skos:broader rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#Material"/>
    </owl:Class>

    <!-- 8. TechnologyConcept -->
    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#TechnologyConcept">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>TechnologyConcept</rdfs:label>
        <skos:prefLabel xml:lang="en">Technology Concept</skos:prefLabel>
        <rdfs:comment>A kind of technical artifact or technology. Examples: MRI, drug-delivery device (pharma); payment network, blockchain (finance); semiconductor, battery, robot arm (manufacturing); AI, cloud computing (general). Procedures and techniques belong under Method.</rdfs:comment>
        <skos:definition>A technical artifact, system, technique, or method.</skos:definition>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
    </owl:Class>

    <!-- 9. Infrastructure -->
    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#Infrastructure">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>Infrastructure</rdfs:label>
        <skos:prefLabel xml:lang="en">Infrastructure</skos:prefLabel>
        <rdfs:comment>A physical facility or built structure. Examples: Pipeline, Port, Refinery Complex, Power Grid, Factory, Terminal, Station.</rdfs:comment>
        <skos:definition>A physical built facility or installation supporting industrial / civic activity.</skos:definition>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
    </owl:Class>

    <!-- 10. SupplyChainConcept -->
    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#SupplyChainConcept">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>SupplyChainConcept</rdfs:label>
        <skos:prefLabel xml:lang="en">Supply Chain Concept</skos:prefLabel>
        <rdfs:comment>A logistics or trade-flow concept. Examples: Supply Chain, Shipping Route, Freight Corridor, Choke Point.</rdfs:comment>
        <skos:definition>A logistics, trade-flow, or supply-chain concept.</skos:definition>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
    </owl:Class>

    <!-- 11. GeographicFeature -->
    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#GeographicFeature">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>GeographicFeature</rdfs:label>
        <skos:prefLabel xml:lang="en">Geographic Feature</skos:prefLabel>
        <rdfs:comment>A place or landform whose label IS a place name with no event/process modifier. Examples: Strait of Hormuz, Kharg Island, Suez Canal, Persian Gulf. See also the geography ontology for finer-grained sub-classes (Country, Sea, Strait, etc.).</rdfs:comment>
        <skos:definition>A named place or landform — geographic identity only, no event modifier.</skos:definition>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
    </owl:Class>

    <!-- 12. DomainConcept (catch-all) -->
    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConcept">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>DomainConcept</rdfs:label>
        <skos:prefLabel xml:lang="en">Domain Concept</skos:prefLabel>
        <rdfs:comment>Last-resort catch-all for a concept that fits none of the other buckets (Quantity, Condition, Process, Method, Intervention, Outcome, Material, PolicyConcept, EconomicConcept, TechnologyConcept, Industry, Infrastructure, SupplyChainConcept, Event). Should be rare; a large DomainConcept branch means a placement was skipped.</rdfs:comment>
        <skos:definition>Catch-all top-level fallback for broad / abstract concepts.</skos:definition>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
    </owl:Class>

    <!-- Phase 2a follow-up buckets (2026-06-15) — table-tying anchors. -->
    <!-- Used by the table_concept_grouping pass to anchor newly-minted
         classes derived from extracted financial-statement tables. -->

    <!-- 13. FinancialTable -->
    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#FinancialTable">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>FinancialTable</rdfs:label>
        <skos:prefLabel xml:lang="en">Financial Table</skos:prefLabel>
        <rdfs:comment>A table of financial values extracted from a source document. Examples: revenue tables, balance sheet tables, capacity tables, segment breakdowns. Subclasses carry per-document table types (e.g. RevenueBySegmentTable, BalanceSheetTable).</rdfs:comment>
        <skos:definition>A table of financial values extracted from a source document; parent class for newly-minted table-type subclasses.</skos:definition>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
    </owl:Class>

    <!-- 14. FinancialObservation -->
    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#FinancialObservation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>FinancialObservation</rdfs:label>
        <skos:prefLabel xml:lang="en">Financial Observation</skos:prefLabel>
        <rdfs:comment>A factual statement read from a financial table cell (e.g. "FY2024 automotive revenue = USD 78.4B"). Distinct from a free-prose viao:Observation artifact; tied to a row + column + table.</rdfs:comment>
        <skos:definition>A factual reading from a row+column intersection in a FinancialTable.</skos:definition>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
    </owl:Class>

    <!-- 15. Metric -->
    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#Metric">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#Quantity"/>
        <rdfs:label>Metric</rdfs:label>
        <skos:prefLabel xml:lang="en">Metric</skos:prefLabel>
        <rdfs:comment>A derived or calculated quantity, in any domain. Examples: response rate, hazard ratio, HbA1c reduction (pharma); net margin, ROE, revenue growth (finance); yield, defect rate, OEE (manufacturing); unemployment rate (general). Distinguished from Measure by being a function of one or more measures rather than directly observed.</rdfs:comment>
        <skos:definition>A derived or calculated numerical value computed from one or more measures.</skos:definition>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
    </owl:Class>

    <!-- 16. Dimension -->
    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#Dimension">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>Dimension</rdfs:label>
        <skos:prefLabel xml:lang="en">Dimension</skos:prefLabel>
        <rdfs:comment>A categorical or qualitative axis used to slice a metric or measure (e.g. Segment, Geography, Period, Product Line, Customer Type).</rdfs:comment>
        <skos:definition>A categorical axis along which metrics and measures are sliced.</skos:definition>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
    </owl:Class>

    <!-- 17. Measure -->
    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#Measure">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#Quantity"/>
        <rdfs:label>Measure</rdfs:label>
        <skos:prefLabel xml:lang="en">Measure</skos:prefLabel>
        <rdfs:comment>A raw measured quantity, directly observed rather than derived. Examples: dose, blood pressure, body weight (pharma); revenue, sales, operating profit (finance); output volume, cycle time (manufacturing); population (general).</rdfs:comment>
        <skos:definition>A raw measured quantity with units, directly observed rather than derived.</skos:definition>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
    </owl:Class>

    <!-- 18. TimePeriod -->
    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#TimePeriod">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>TimePeriod</rdfs:label>
        <skos:prefLabel xml:lang="en">Time Period</skos:prefLabel>
        <rdfs:comment>A bounded interval of time used as a slicing axis on financial reports (e.g. FY2024, Q1 2024, "first half of 2022"). Distinct from time:Interval in scope: used specifically for reporting-period anchors on financial tables.</rdfs:comment>
        <skos:definition>A bounded reporting interval used as a slicing axis on financial tables.</skos:definition>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
    </owl:Class>

    <!-- Domain-neutral concept layer (2026-10-24). The buckets above leaned
         toward economics and supply chain, so pharma and manufacturing concepts
         had nowhere to go: 482 pharma classes fell into DomainConcept and
         MedicalCondition sat under owl:Thing, outside every concept root.
         These roots hold the KINDS of concept any domain develops; the
         concept pass in extract-entities offers only classes under them. -->

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#Quantity">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>Quantity</rdfs:label>
        <skos:prefLabel xml:lang="en">Quantity</skos:prefLabel>
        <rdfs:comment>Any kind of measurable or reported amount, raw (Measure) or derived (Metric). Examples: dose, efficacy rate (pharma); revenue, EBITDA, related-party sales (finance); yield, throughput, defect rate (manufacturing); population, temperature (general). Name the kind, not a reading: 'revenue', not 'revenue of 35,423'.</rdfs:comment>
        <skos:definition>A kind of measurable or reported amount; parent of Measure and Metric.</skos:definition>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#Condition">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>Condition</rdfs:label>
        <skos:prefLabel xml:lang="en">Condition</skos:prefLabel>
        <rdfs:comment>A kind of state or condition something can be in, typically undesirable or notable. Examples: type 2 diabetes, obesity, hypoglycemia, adverse event (pharma); insolvency, impairment, liquidity shortfall (finance); defect, downtime, overcapacity (manufacturing); drought, shortage (general).</rdfs:comment>
        <skos:definition>A kind of state or condition a person, organization, system or thing can be in.</skos:definition>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#Method">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>Method</rdfs:label>
        <skos:prefLabel xml:lang="en">Method</skos:prefLabel>
        <rdfs:comment>A kind of technique, procedure, protocol or approach used to do something. Examples: assay, dosing regimen, randomization (pharma); valuation method, hedge accounting, DCF (finance); lean manufacturing, statistical process control, injection molding (manufacturing); survey method (general).</rdfs:comment>
        <skos:definition>A kind of technique, procedure or approach.</skos:definition>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#Intervention">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>Intervention</rdfs:label>
        <skos:prefLabel xml:lang="en">Intervention</skos:prefLabel>
        <rdfs:comment>A kind of deliberate action taken to change a situation. Examples: therapy, vaccination, bariatric surgery (pharma); share buyback, hedging, recapitalization (finance); preventive maintenance, retooling, recall (manufacturing); sanction, subsidy program (general).</rdfs:comment>
        <skos:definition>A kind of deliberate action taken to change a situation.</skos:definition>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#Outcome">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>Outcome</rdfs:label>
        <skos:prefLabel xml:lang="en">Outcome</skos:prefLabel>
        <rdfs:comment>A kind of result or effect that follows from something. Examples: remission, weight loss, side effect, mortality (pharma); return, loss, default (finance); scrap, rework, quality improvement (manufacturing); impact, benefit (general).</rdfs:comment>
        <skos:definition>A kind of result or effect that follows from a process, intervention or condition.</skos:definition>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
    </owl:Class>

    <!-- Generic concept predicates. Domain owl:Thing on purpose: any entity
         can report a quantity, have a condition or use a method. The
         relationship menu in extract-entities offers each one when a chunk
         holds an entity under its RANGE root (predicates.GENERIC_CONCEPT_PREDICATES),
         which is what links concept entities into the entity-to-entity walk. -->

    <owl:ObjectProperty rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#hasMetric">
        <rdfs:label>hasMetric</rdfs:label>
        <skos:prefLabel xml:lang="en">has metric</skos:prefLabel>
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#Quantity"/>
        <rdfs:comment>The subject reports, has or is measured by this quantity. 'LG Energy Solution hasMetric related-party revenue'; 'semaglutide hasMetric HbA1c reduction'; 'Plant A hasMetric defect rate'.</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#hasCondition">
        <rdfs:label>hasCondition</rdfs:label>
        <skos:prefLabel xml:lang="en">has condition</skos:prefLabel>
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#Condition"/>
        <rdfs:comment>The subject has, suffers or is in this condition. 'patient cohort hasCondition type 2 diabetes'; 'Company X hasCondition going-concern doubt'.</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#undergoesProcess">
        <rdfs:label>undergoesProcess</rdfs:label>
        <skos:prefLabel xml:lang="en">undergoes process</skos:prefLabel>
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#Process"/>
        <rdfs:comment>The subject undergoes or performs this process. 'tirzepatide undergoesProcess phase 3 trial'; 'Company X undergoesProcess restructuring'.</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#usesMethod">
        <rdfs:label>usesMethod</rdfs:label>
        <skos:prefLabel xml:lang="en">uses method</skos:prefLabel>
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#Method"/>
        <rdfs:comment>The subject uses this method, technique or procedure. 'study usesMethod randomization'; 'factory usesMethod lean manufacturing'.</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#receivesIntervention">
        <rdfs:label>receivesIntervention</rdfs:label>
        <skos:prefLabel xml:lang="en">receives intervention</skos:prefLabel>
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#Intervention"/>
        <rdfs:comment>The subject receives or carries out this intervention. 'patients receivesIntervention bariatric surgery'; 'Company X receivesIntervention recapitalization'.</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#hasOutcome">
        <rdfs:label>hasOutcome</rdfs:label>
        <skos:prefLabel xml:lang="en">has outcome</skos:prefLabel>
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#Outcome"/>
        <rdfs:comment>This outcome results from the subject. 'semaglutide hasOutcome weight loss'; 'recall hasOutcome scrap'.</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#regulatedBy">
        <rdfs:label>regulatedBy</rdfs:label>
        <skos:prefLabel xml:lang="en">regulated by</skos:prefLabel>
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#PolicyConcept"/>
        <rdfs:comment>The subject is governed or constrained by this rule, standard or policy. 'Ozempic regulatedBy boxed warning'; 'bank regulatedBy capital requirement'.</rdfs:comment>
    </owl:ObjectProperty>

</rdf:RDF>
