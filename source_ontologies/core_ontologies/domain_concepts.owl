        <skos:definition>Money spent on acquiring or upgrading long-lived physical assets.</skos:definition>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
        <inConceptArea rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#CashFlow"/>
        <inConceptArea rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#FinancingAndCapitalManagement"/>
        <conceptTerm>capital expenditure</conceptTerm>
        <conceptTerm>capital expenditures</conceptTerm>
        <conceptTerm>capex</conceptTerm>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#Dividends">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#Measure"/>
        <rdfs:label>Dividends</rdfs:label>
        <skos:prefLabel xml:lang="en">Dividends</skos:prefLabel>
        <rdfs:comment>Distributions of profit paid to shareholders.</rdfs:comment>
        <skos:definition>Distributions of profit paid to shareholders.</skos:definition>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
        <inConceptArea rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#CashFlow"/>
        <inConceptArea rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#FinancingAndCapitalManagement"/>
        <conceptTerm>dividend</conceptTerm>
        <conceptTerm>dividends</conceptTerm>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#FinancialStatements">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#ReportingDocument"/>
        <rdfs:label>FinancialStatements</rdfs:label>
        <skos:prefLabel xml:lang="en">Financial statements</skos:prefLabel>
        <rdfs:comment>The formal statements that report an organization's finances: balance sheet, income statement, cash flow statement and related statements.</rdfs:comment>
        <skos:definition>The formal statements that report an organization's finances: balance sheet, income statement, cash flow statement and related statements.</skos:definition>
        <skos:scopeNote xml:lang="en">A kind of reporting document. An audit report is a separate reporting document about them, not one of them.</skos:scopeNote>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
        <inConceptArea rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#FinancialReporting"/>
        <conceptTerm>financial statements</conceptTerm>
        <conceptTerm>financial statement</conceptTerm>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#BalanceSheet">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#FinancialStatements"/>
        <rdfs:label>BalanceSheet</rdfs:label>
        <skos:prefLabel xml:lang="en">Balance sheet</skos:prefLabel>
        <skos:altLabel xml:lang="en">statement of financial position</skos:altLabel>
        <rdfs:comment>The statement of what an organization owns and owes at a date.</rdfs:comment>
        <skos:definition>The statement of what an organization owns and owes at a date.</skos:definition>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
        <inConceptArea rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#FinancialReporting"/>
        <inConceptArea rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#FinancialPosition"/>
        <conceptTerm>balance sheet</conceptTerm>
        <conceptTerm>statement of financial position</conceptTerm>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#IncomeStatement">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#FinancialStatements"/>
        <rdfs:label>IncomeStatement</rdfs:label>
        <skos:prefLabel xml:lang="en">Income statement</skos:prefLabel>
        <skos:altLabel xml:lang="en">statement of profit or loss</skos:altLabel>
        <skos:altLabel xml:lang="en">profit and loss statement</skos:altLabel>
        <rdfs:comment>The statement of revenue, expenses and profit or loss for a period.</rdfs:comment>
        <skos:definition>The statement of revenue, expenses and profit or loss for a period.</skos:definition>
        <skos:scopeNote xml:lang="en">Not interchangeable with the statement of comprehensive income, which adds other comprehensive income; under IFRS the two may be presented as one statement.</skos:scopeNote>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
        <skos:related rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#StatementOfComprehensiveIncome"/>
        <inConceptArea rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#FinancialReporting"/>
        <inConceptArea rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#FinancialPerformance"/>
        <conceptTerm>income statement</conceptTerm>
        <conceptTerm>statement of profit or loss</conceptTerm>
        <conceptTerm>profit and loss statement</conceptTerm>
        <conceptTerm>p&amp;l statement</conceptTerm>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#StatementOfComprehensiveIncome">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#FinancialStatements"/>
        <rdfs:label>StatementOfComprehensiveIncome</rdfs:label>
        <skos:prefLabel xml:lang="en">Statement of comprehensive income</skos:prefLabel>
        <rdfs:comment>The statement of profit or loss plus other comprehensive income for a period.</rdfs:comment>
        <skos:definition>The statement of profit or loss plus other comprehensive income for a period.</skos:definition>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
        <skos:related rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#IncomeStatement"/>
        <inConceptArea rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#FinancialReporting"/>
        <inConceptArea rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#FinancialPerformance"/>
        <conceptTerm>statement of comprehensive income</conceptTerm>
        <conceptTerm>comprehensive income statement</conceptTerm>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#CashFlowStatement">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#FinancialStatements"/>
        <rdfs:label>CashFlowStatement</rdfs:label>
        <skos:prefLabel xml:lang="en">Cash flow statement</skos:prefLabel>
        <skos:altLabel xml:lang="en">statement of cash flows</skos:altLabel>
        <rdfs:comment>The statement of cash flows from operating, investing and financing activities for a period.</rdfs:comment>
        <skos:definition>The statement of cash flows from operating, investing and financing activities for a period.</skos:definition>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
        <inConceptArea rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#FinancialReporting"/>
        <inConceptArea rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#CashFlow"/>
        <conceptTerm>cash flow statement</conceptTerm>
        <conceptTerm>statement of cash flows</conceptTerm>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#StatementOfChangesInEquity">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#FinancialStatements"/>
        <rdfs:label>StatementOfChangesInEquity</rdfs:label>
        <skos:prefLabel xml:lang="en">Statement of changes in equity</skos:prefLabel>
        <skos:altLabel xml:lang="en">statement of changes in shareholders' equity</skos:altLabel>
        <rdfs:comment>The statement of movements in each component of equity over a period.</rdfs:comment>
        <skos:definition>The statement of movements in each component of equity over a period.</skos:definition>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
        <inConceptArea rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#FinancialReporting"/>
        <inConceptArea rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#FinancialPosition"/>
        <conceptTerm>statement of changes in equity</conceptTerm>
        <conceptTerm>statement of changes in shareholders equity</conceptTerm>
        <conceptTerm>statement of stockholders equity</conceptTerm>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#NotesToFinancialStatements">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#ReportingDocument"/>
        <rdfs:label>NotesToFinancialStatements</rdfs:label>
        <skos:prefLabel xml:lang="en">Notes to financial statements</skos:prefLabel>
        <rdfs:comment>The explanatory notes that accompany the financial statements.</rdfs:comment>
        <skos:definition>The explanatory notes that accompany the financial statements.</skos:definition>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
        <inConceptArea rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#FinancialReporting"/>
        <conceptTerm>notes to financial statements</conceptTerm>
        <conceptTerm>notes to the financial statements</conceptTerm>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#AuditReport">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#ReportingDocument"/>
        <rdfs:label>AuditReport</rdfs:label>
        <skos:prefLabel xml:lang="en">Audit report</skos:prefLabel>
        <skos:altLabel xml:lang="en">auditor's report</skos:altLabel>
        <skos:altLabel xml:lang="en">independent auditor's report</skos:altLabel>
        <rdfs:comment>An auditor's opinion on whether the financial statements are fairly presented.</rdfs:comment>
        <skos:definition>An auditor's opinion on whether the financial statements are fairly presented.</skos:definition>
        <skos:scopeNote xml:lang="en">A reporting document about the financial statements, not a financial statement.</skos:scopeNote>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
        <inConceptArea rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#FinancialReporting"/>
        <conceptTerm>audit report</conceptTerm>
        <conceptTerm>auditor's report</conceptTerm>
        <conceptTerm>independent auditor's report</conceptTerm>
        <conceptTerm>audit opinion</conceptTerm>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#QuarterlyResults">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
