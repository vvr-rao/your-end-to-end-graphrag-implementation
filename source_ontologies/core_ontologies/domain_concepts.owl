    <!-- Generic concept predicates: entity -> KIND of concept (IRIs unchanged) -->
    <owl:ObjectProperty rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#hasMetric">
        <rdfs:label>hasMetric</rdfs:label>
        <skos:prefLabel xml:lang="en">has metric</skos:prefLabel>
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#Quantity"/>
        <rdfs:comment>The subject reports, has or is measured by this KIND of quantity. 'LG Energy Solution hasMetric Revenue'; 'trial hasMetric response rate'.</rdfs:comment>
        <skos:scopeNote xml:lang="en">Links an entity to a concept DESCRIPTOR (a kind of quantity, condition, process...), never to a value. Numerical facts are FinancialObservation individuals from the table pipeline, each with its entity, concept, period, unit and source.</skos:scopeNote>
    </owl:ObjectProperty>

