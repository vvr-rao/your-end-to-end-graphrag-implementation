        <rdfs:subClassOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#ConceptArea"/>
        <rdfs:label>Inventory</rdfs:label>
        <skos:prefLabel xml:lang="en">Inventory</skos:prefLabel>
        <rdfs:comment>Stock held and how it moves.</rdfs:comment>
        <skos:definition>Stock held and how it moves.</skos:definition>
        <skos:scopeNote xml:lang="en">Includes: stock levels, safety stock, stockouts, inventory turnover. The money value of inventory is InventoryValue (WorkingCapitalManagement).</skos:scopeNote>
