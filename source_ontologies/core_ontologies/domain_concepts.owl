    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#SingleSourcing">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#Condition"/>
        <rdfs:label>SingleSourcing</rdfs:label>
        <skos:prefLabel xml:lang="en">Single sourcing</skos:prefLabel>
        <rdfs:comment>Buying an input from one supplier by choice, although other suppliers exist.</rdfs:comment>
        <skos:definition>Buying an input from one supplier by choice, although other suppliers exist.</skos:definition>
        <skos:scopeNote xml:lang="en">By choice; when only one supplier exists it is SoleSourcing.</skos:scopeNote>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
        <skos:related rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#SoleSourcing"/>
        <inConceptArea rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#Sourcing"/>
        <inConceptArea rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#SupplyChainRiskAndResilience"/>
        <conceptTerm>single sourcing</conceptTerm>
        <conceptTerm>single source</conceptTerm>
        <conceptTerm>single-sourced</conceptTerm>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#SoleSourcing">
