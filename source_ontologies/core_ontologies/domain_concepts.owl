        <skos:prefLabel xml:lang="en">Quarterly results</skos:prefLabel>
        <rdfs:comment>The financial results an organization reports for a fiscal quarter.</rdfs:comment>
        <skos:definition>The financial results an organization reports for a fiscal quarter.</skos:definition>
        <skos:scopeNote xml:lang="en">The reported results. Publishing them is an EarningsRelease; discussing them with analysts is an EarningsCall.</skos:scopeNote>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
        <skos:related rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#EarningsRelease"/>
        <skos:related rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#EarningsCall"/>
        <inConceptArea rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#FinancialReporting"/>
        <inConceptArea rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#MarketEvents"/>
        <conceptTerm>quarterly results</conceptTerm>
        <conceptTerm>quarterly report</conceptTerm>
        <conceptTerm>quarterly earnings</conceptTerm>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#AccountingPolicy">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#PolicyConcept"/>
        <rdfs:label>AccountingPolicy</rdfs:label>
        <skos:prefLabel xml:lang="en">Accounting policy</skos:prefLabel>
        <rdfs:comment>A principle or rule an organization applies when preparing its financial statements.</rdfs:comment>
        <skos:definition>A principle or rule an organization applies when preparing its financial statements.</skos:definition>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
        <inConceptArea rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#FinancialReporting"/>
        <conceptTerm>accounting policy</conceptTerm>
        <conceptTerm>accounting policies</conceptTerm>
        <conceptTerm>accounting standard</conceptTerm>
