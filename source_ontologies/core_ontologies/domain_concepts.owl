    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#AdverseEvent">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#Event"/>
        <rdfs:label>AdverseEvent</rdfs:label>
        <skos:prefLabel xml:lang="en">Adverse event</skos:prefLabel>
        <skos:altLabel xml:lang="en">AE</skos:altLabel>
        <rdfs:comment>An untoward medical occurrence in a person given a treatment, whether or not it is caused by the treatment.</rdfs:comment>
        <skos:definition>An untoward medical occurrence in a person given a treatment, whether or not it is caused by the treatment.</skos:definition>
        <skos:scopeNote xml:lang="en">Not attributed to the drug. Attributed effects are AdverseDrugReaction, a narrower kind; never merge the two.</skos:scopeNote>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
        <skos:related rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#AdverseDrugReaction"/>
        <skos:related rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#Toxicity"/>
        <inConceptArea rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DrugSafety"/>
        <conceptTerm>adverse event</conceptTerm>
        <conceptTerm>adverse events</conceptTerm>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#AdverseDrugReaction">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#AdverseEvent"/>
        <rdfs:label>AdverseDrugReaction</rdfs:label>
        <skos:prefLabel xml:lang="en">Adverse drug reaction</skos:prefLabel>
        <skos:altLabel xml:lang="en">ADR</skos:altLabel>
        <rdfs:comment>A harmful, unintended response to a medicine where a causal link with the medicine is at least reasonably possible.</rdfs:comment>
        <skos:definition>A harmful, unintended response to a medicine where a causal link with the medicine is at least reasonably possible.</skos:definition>
        <skos:scopeNote xml:lang="en">An adverse event attributed to the drug. 'Side effect' is routed here; it is not a synonym of adverse event.</skos:scopeNote>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
        <skos:related rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#AdverseEvent"/>
        <inConceptArea rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DrugSafety"/>
        <conceptTerm>adverse drug reaction</conceptTerm>
        <conceptTerm>adverse drug reactions</conceptTerm>
        <conceptTerm>side effect</conceptTerm>
        <conceptTerm>side effects</conceptTerm>
        <conceptTerm>adverse reaction</conceptTerm>
        <conceptTerm>adverse reactions</conceptTerm>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#SeriousAdverseEvent">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#AdverseEvent"/>
        <rdfs:label>SeriousAdverseEvent</rdfs:label>
        <skos:prefLabel xml:lang="en">Serious adverse event</skos:prefLabel>
        <skos:altLabel xml:lang="en">SAE</skos:altLabel>
        <rdfs:comment>An adverse event that results in death, is life-threatening, requires hospitalization or causes lasting disability.</rdfs:comment>
        <skos:definition>An adverse event that results in death, is life-threatening, requires hospitalization or causes lasting disability.</skos:definition>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
        <inConceptArea rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DrugSafety"/>
        <conceptTerm>serious adverse event</conceptTerm>
        <conceptTerm>serious adverse events</conceptTerm>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#Toxicity">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#Condition"/>
