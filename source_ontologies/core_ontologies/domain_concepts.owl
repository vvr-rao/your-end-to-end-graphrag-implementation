        <rdfs:label>Logistics</rdfs:label>
        <skos:prefLabel xml:lang="en">Logistics</skos:prefLabel>
        <rdfs:comment>Moving and storing goods between where they are made and where they are used.</rdfs:comment>
        <skos:definition>Moving and storing goods between where they are made and where they are used.</skos:definition>
        <skos:scopeNote xml:lang="en">Includes: transportation, warehousing and distribution, freight, lead times, transport infrastructure such as ports and airports. Excludes: buying the goods (Sourcing).</skos:scopeNote>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#ConceptAreaScheme"/>
        <skos:broader rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#SupplyChainManagement"/>
        <conceptTerm>logistics</conceptTerm>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#Transportation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#ConceptArea"/>
        <rdfs:label>Transportation</rdfs:label>
        <skos:prefLabel xml:lang="en">Transportation</skos:prefLabel>
        <rdfs:comment>Moving goods or people: infrastructure, modes, equipment, routes, operations and performance.</rdfs:comment>
        <skos:definition>Moving goods or people: infrastructure, modes, equipment, routes, operations and performance.</skos:definition>
        <skos:scopeNote xml:lang="en">Includes: ports, airports, rail terminals, roads, bridges, canals; road, rail, air, maritime and inland-waterway modes; trucks, ships, aircraft, rail wagons; shipping, loading, unloading, transshipment, delivery; transit time, freight cost, reliability, utilization. Excludes: storage (WarehousingAndDistribution).</skos:scopeNote>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#ConceptAreaScheme"/>
        <skos:broader rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#Logistics"/>
        <conceptTerm>transportation</conceptTerm>
        <conceptTerm>transport</conceptTerm>
    </owl:Class>

