        <rdfs:label>WarehousingAndDistribution</rdfs:label>
        <skos:prefLabel xml:lang="en">Warehousing and distribution</skos:prefLabel>
        <rdfs:comment>Storing goods and getting orders out to customers.</rdfs:comment>
        <skos:definition>Storing goods and getting orders out to customers.</skos:definition>
        <skos:scopeNote xml:lang="en">Includes: warehouses, distribution centers, picking, fulfillment. Excludes: line-haul transport (Transportation).</skos:scopeNote>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#ConceptAreaScheme"/>
        <skos:broader rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#Logistics"/>
        <conceptTerm>warehousing</conceptTerm>
        <conceptTerm>distribution network</conceptTerm>
        <conceptTerm>fulfillment</conceptTerm>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#TradeAndCustoms">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#ConceptArea"/>
        <rdfs:label>TradeAndCustoms</rdfs:label>
        <skos:prefLabel xml:lang="en">Trade and customs</skos:prefLabel>
        <rdfs:comment>Rules and procedures for moving goods across borders.</rdfs:comment>
        <skos:definition>Rules and procedures for moving goods across borders.</skos:definition>
        <skos:scopeNote xml:lang="en">Includes: tariffs, customs clearance, trade restrictions, sanctions, rules of origin, trade agreements. Excludes: corporate income tax (Taxation).</skos:scopeNote>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#ConceptAreaScheme"/>
        <skos:broader rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#SupplyChainManagement"/>
