        <conceptTerm>trade and customs</conceptTerm>
        <conceptTerm>customs</conceptTerm>
        <conceptTerm>international trade</conceptTerm>
        <conceptTerm>trade policy</conceptTerm>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#TraceabilityAndColdChain">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
