        <rdfs:label>TraceabilityAndColdChain</rdfs:label>
        <skos:prefLabel xml:lang="en">Traceability and cold chain</skos:prefLabel>
        <rdfs:comment>Knowing where each lot came from and went, and keeping temperature-sensitive goods in range.</rdfs:comment>
        <skos:definition>Knowing where each lot came from and went, and keeping temperature-sensitive goods in range.</skos:definition>
        <skos:scopeNote xml:lang="en">Includes: lots and batches, provenance, serialization, cold chain, temperature control.</skos:scopeNote>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#ConceptAreaScheme"/>
        <skos:broader rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#SupplyChainManagement"/>
        <conceptTerm>traceability</conceptTerm>
        <conceptTerm>cold chain</conceptTerm>
        <conceptTerm>track and trace</conceptTerm>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#SupplyChainRiskAndResilience">
