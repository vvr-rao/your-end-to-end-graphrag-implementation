        <skos:scopeNote xml:lang="en">Includes: shortages, port closures, tariffs and sanctions as they affect supply.</skos:scopeNote>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#ConceptAreaScheme"/>
        <skos:broader rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#SupplyChainRiskAndResilience"/>
        <conceptTerm>supply disruption</conceptTerm>
        <conceptTerm>supply disruptions</conceptTerm>
        <conceptTerm>supply chain disruption</conceptTerm>
        <conceptTerm>supply chain disruptions</conceptTerm>
    </owl:Class>

