        <conceptTerm>trial phase</conceptTerm>
        <conceptTerm>phase 1</conceptTerm>
        <conceptTerm>phase 2</conceptTerm>
        <conceptTerm>phase 3</conceptTerm>
        <conceptTerm>phase 4</conceptTerm>
