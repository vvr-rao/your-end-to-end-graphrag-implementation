        <conceptTerm>corporate news</conceptTerm>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#GeopoliticalEvents">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#ConceptArea"/>
        <rdfs:label>GeopoliticalEvents</rdfs:label>
        <skos:prefLabel xml:lang="en">Geopolitical events</skos:prefLabel>
        <rdfs:comment>Things that happen between or within states.</rdfs:comment>
        <skos:definition>Things that happen between or within states.</skos:definition>
        <skos:scopeNote xml:lang="en">Includes: conflicts, elections, sanctions, trade agreements.</skos:scopeNote>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#ConceptAreaScheme"/>
        <skos:topConceptOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#ConceptAreaScheme"/>
        <conceptTerm>geopolitical events</conceptTerm>
        <conceptTerm>geopolitical news</conceptTerm>
        <conceptTerm>geopolitics</conceptTerm>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#LegalAndRegulatoryEvents">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#ConceptArea"/>
        <rdfs:label>LegalAndRegulatoryEvents</rdfs:label>
        <skos:prefLabel xml:lang="en">Legal and regulatory events</skos:prefLabel>
        <rdfs:comment>Laws made and enforced.</rdfs:comment>
        <skos:definition>Laws made and enforced.</skos:definition>
        <skos:scopeNote xml:lang="en">Includes: law enactments, lawsuits, investigations, fines. The laws themselves are Law (PolicyConcept).</skos:scopeNote>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#ConceptAreaScheme"/>
        <skos:topConceptOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#ConceptAreaScheme"/>
        <conceptTerm>legal events</conceptTerm>
        <conceptTerm>legal developments</conceptTerm>
        <conceptTerm>regulatory events</conceptTerm>
        <conceptTerm>regulatory developments</conceptTerm>
    </owl:Class>

    <!-- ===== Type roots ===== -->
    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#Quantity">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>Quantity</rdfs:label>
        <skos:prefLabel xml:lang="en">Quantity</skos:prefLabel>
        <rdfs:comment>Any kind of measurable or reported amount. Measure (reported or measured amounts) is its main child and Metric (ratios, rates, indices) is a kind of Measure. Examples: dose, revenue, efficacy rate, defect rate.</rdfs:comment>
        <skos:definition>A kind of measurable or reported amount; the parent of Measure.</skos:definition>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
        <skos:topConceptOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#Measure">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#Quantity"/>
        <rdfs:label>Measure</rdfs:label>
        <skos:prefLabel xml:lang="en">Measure</skos:prefLabel>
        <rdfs:comment>A reported or measured quantity, usually with a unit. Whether the figure is read off an instrument or computed by an accountant does not matter: revenue, profit, debt balance, dose, body weight and output volume are all Measures. Ratios, rates and indices are the more specific Metric.</rdfs:comment>
        <skos:definition>A kind of reported or measured quantity, usually with a unit: revenue, profit, dose, output volume, headcount.</skos:definition>
        <skos:scopeNote xml:lang="en">Use Metric when the quantity is defined as a ratio, rate, per-unit figure or index.</skos:scopeNote>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#Metric">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#Measure"/>
        <rdfs:label>Metric</rdfs:label>
        <skos:prefLabel xml:lang="en">Metric</skos:prefLabel>
        <rdfs:comment>A measure defined as a ratio, rate, per-unit figure or index of other measures. Examples: gross margin, earnings per share, response rate, hazard ratio, defect rate, inventory turnover.</rdfs:comment>
        <skos:definition>A kind of measure defined as a ratio, rate, per-unit figure or index: margin, earnings per share, defect rate, hazard ratio.</skos:definition>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#Condition">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>Condition</rdfs:label>
        <skos:prefLabel xml:lang="en">Condition</skos:prefLabel>
        <rdfs:comment>A kind of state or condition something can be in, typically undesirable or notable. Examples: type 2 diabetes, hypertension (pharma); insolvency, currency risk (finance); corrosion, stockout (manufacturing).</rdfs:comment>
        <skos:definition>A kind of state or condition a person, organization, system or thing can be in.</skos:definition>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
        <skos:topConceptOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#Process">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>Process</rdfs:label>
        <skos:prefLabel xml:lang="en">Process</skos:prefLabel>
        <rdfs:comment>A kind of activity or series of steps that unfolds over time, in any domain. Examples: clinical trial, drug absorption (pharma); procurement, maintenance (manufacturing); refinancing (finance).</rdfs:comment>
        <skos:definition>A kind of activity or series of steps that unfolds over time.</skos:definition>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
        <skos:topConceptOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#Method">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>Method</rdfs:label>
        <skos:prefLabel xml:lang="en">Method</skos:prefLabel>
        <rdfs:comment>A kind of technique, procedure, protocol or approach used to do something. Examples: assay, randomized controlled design (pharma); discounted cash flow valuation (finance); lean manufacturing, six sigma (manufacturing).</rdfs:comment>
        <skos:definition>A kind of technique, procedure, protocol or approach used to do something.</skos:definition>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
        <skos:topConceptOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#Intervention">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>Intervention</rdfs:label>
        <skos:prefLabel xml:lang="en">Intervention</skos:prefLabel>
        <rdfs:comment>A kind of deliberate action taken to change a situation. Examples: therapy, vaccination, bariatric surgery (pharma); hedging, cost-cutting programme (finance).</rdfs:comment>
        <skos:definition>A kind of deliberate action taken to change a situation.</skos:definition>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
        <skos:topConceptOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#Outcome">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>Outcome</rdfs:label>
        <skos:prefLabel xml:lang="en">Outcome</skos:prefLabel>
        <rdfs:comment>A kind of result or effect that follows from something. Examples: remission, weight loss, mortality (pharma); market share gain (finance).</rdfs:comment>
        <skos:definition>A kind of result or effect that follows from a process, intervention or condition.</skos:definition>
        <skos:scopeNote xml:lang="en">An observed result. The variable a study is designed to measure is a TrialEndpoint.</skos:scopeNote>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
        <skos:topConceptOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#PolicyConcept">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>PolicyConcept</rdfs:label>
        <skos:prefLabel xml:lang="en">Policy concept</skos:prefLabel>
        <rdfs:comment>A kind of rule, regulation, standard, framework or governance instrument. Examples: boxed warning, post-marketing requirement (pharma); accounting policy, tariff (finance, trade); safety standard (manufacturing).</rdfs:comment>
        <skos:definition>A kind of rule, standard, framework or governance instrument.</skos:definition>
        <skos:scopeNote xml:lang="en">A rule itself. The act of making or changing it is an Event (LawEnactment); an agreement between parties is an Agreement.</skos:scopeNote>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
        <skos:topConceptOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#EconomicConcept">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>EconomicConcept</rdfs:label>
        <skos:prefLabel xml:lang="en">Economic concept</skos:prefLabel>
        <rdfs:comment>A market, monetary or financial phenomenon or thing that is not itself an amount. Examples: debt, asset, loan, subsidy, inflation, recession.</rdfs:comment>
        <skos:definition>A kind of market, monetary or financial thing that is not itself an amount: debt, asset, financial instrument, subsidy, market.</skos:definition>
        <skos:scopeNote xml:lang="en">An amount of money is a Measure (DebtBalance, Assets), not an EconomicConcept.</skos:scopeNote>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
        <skos:topConceptOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#TechnologyConcept">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>TechnologyConcept</rdfs:label>
        <skos:prefLabel xml:lang="en">Technology concept</skos:prefLabel>
        <rdfs:comment>A kind of engineered device, machine, system or technology. Examples: MRI scanner, drug-delivery device (pharma); payment network (finance); battery, industrial robot, truck (manufacturing, transport).</rdfs:comment>
        <skos:definition>A kind of engineered device, machine, system or technology.</skos:definition>
        <skos:scopeNote xml:lang="en">Techniques, procedures and ways of doing something are Method, not TechnologyConcept.</skos:scopeNote>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
        <skos:topConceptOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#Industry">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>Industry</rdfs:label>
        <skos:prefLabel xml:lang="en">Industry</skos:prefLabel>
        <rdfs:comment>A kind of human economic activity. Examples: Agriculture, Manufacturing, Mining, Healthcare, Energy, Transportation, Finance.</rdfs:comment>
        <skos:definition>A kind of human economic activity (sector or branch of the economy).</skos:definition>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
        <skos:topConceptOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#Infrastructure">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>Infrastructure</rdfs:label>
        <skos:prefLabel xml:lang="en">Infrastructure</skos:prefLabel>
        <rdfs:comment>A physical facility or built structure. Examples: Pipeline, Port, Refinery Complex, Power Grid, Factory, Terminal.</rdfs:comment>
        <skos:definition>A kind of physical built facility or installation supporting industrial or civic activity.</skos:definition>
        <skos:scopeNote xml:lang="en">A named facility (Port of Rotterdam) is an instance; the kind (Port) is the class.</skos:scopeNote>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
        <skos:topConceptOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#SupplyChainConcept">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>SupplyChainConcept</rdfs:label>
        <skos:prefLabel xml:lang="en">Supply chain concept</skos:prefLabel>
        <rdfs:comment>A logistics or trade-flow concept. Examples: Supply Chain, Shipping Route, Freight Corridor, Choke Point, Cold Chain.</rdfs:comment>
        <skos:definition>A kind of logistics, trade-flow or supply-chain concept.</skos:definition>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
        <skos:topConceptOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#Material">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>Material</rdfs:label>
        <skos:prefLabel xml:lang="en">Material</skos:prefLabel>
        <rdfs:comment>A kind of physical substance, compound, component or commodity. Examples: active ingredient, excipient (pharma); steel, resin, raw material, finished goods (manufacturing); crude oil (energy).</rdfs:comment>
        <skos:definition>A kind of physical substance, compound, component or commodity.</skos:definition>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
        <skos:topConceptOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#NaturalResource">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#Material"/>
        <rdfs:label>NaturalResource</rdfs:label>
        <skos:prefLabel xml:lang="en">Natural resource</skos:prefLabel>
        <rdfs:comment>An extracted natural input. Examples: Crude Oil, Natural Gas, Ore, Timber, Phosphate Rock.</rdfs:comment>
        <skos:definition>A naturally occurring material extracted from the environment as an industrial input.</skos:definition>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
        <skos:broader rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#Material"/>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#Event">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>Event</rdfs:label>
        <skos:prefLabel xml:lang="en">Event</skos:prefLabel>
        <rdfs:comment>A happening with a time signature. Kinds: acquisition, election, port closure, law enactment, agreement signing. Named happenings (Iran-Israel war, COVID-19 pandemic) are instances.</rdfs:comment>
        <skos:definition>A kind of happening at a point or span in time: an acquisition, a conflict, a law's enactment, an adverse event.</skos:definition>
        <skos:scopeNote xml:lang="en">The happening, not the thing it creates: an agreement signing is an Event, the agreement is an Agreement; a law's enactment is an Event, the law is a Law.</skos:scopeNote>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
        <skos:topConceptOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#GeographicFeature">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>GeographicFeature</rdfs:label>
        <skos:prefLabel xml:lang="en">Geographic feature</skos:prefLabel>
        <rdfs:comment>A place or landform whose label IS a place name with no event/process modifier. Examples: Strait of Hormuz, Khor Fakkan, Rhine.</rdfs:comment>
        <skos:definition>A named place or landform: geographic identity only, no event modifier.</skos:definition>
        <skos:scopeNote xml:lang="en">Built transport facilities (ports, airports) are TransportInfrastructure, not GeographicFeature.</skos:scopeNote>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
        <skos:topConceptOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConcept">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>DomainConcept</rdfs:label>
        <skos:prefLabel xml:lang="en">Domain concept</skos:prefLabel>
        <rdfs:comment>Last-resort catch-all for a concept that fits none of the other roots (Quantity, Condition, Process, Method, Intervention, Outcome, PolicyConcept, EconomicConcept, TechnologyConcept, Industry, Infrastructure, SupplyChainConcept, Material, Event, Agreement, IntellectualProperty, Plan, Classification, InformationArtifact).</rdfs:comment>
        <skos:definition>Last-resort catch-all for a concept that fits none of the other roots.</skos:definition>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
        <skos:topConceptOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#Agreement">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>Agreement</rdfs:label>
        <skos:prefLabel xml:lang="en">Agreement</skos:prefLabel>
        <rdfs:comment>A binding arrangement between parties, as a standing thing with terms and parties. Examples: supply contract, power purchase agreement, joint venture, trade agreement, licensing deal.</rdfs:comment>
        <skos:definition>A kind of binding arrangement between two or more parties: contract, partnership, trade agreement.</skos:definition>
        <skos:scopeNote xml:lang="en">The arrangement itself. Its signing or formation is an AgreementSigning event.</skos:scopeNote>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
        <skos:topConceptOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#IntellectualProperty">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>IntellectualProperty</rdfs:label>
        <skos:prefLabel xml:lang="en">Intellectual property</skos:prefLabel>
        <rdfs:comment>A legally protected intangible creation. Examples: patent, trademark, copyright, trade secret.</rdfs:comment>
        <skos:definition>A kind of legally protected intangible creation: patent, trademark, copyright.</skos:definition>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
        <skos:topConceptOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#Plan">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>Plan</rdfs:label>
        <skos:prefLabel xml:lang="en">Plan</skos:prefLabel>
        <rdfs:comment>An intended course of action set out in advance. Examples: product roadmap, contingency plan, production order, capital allocation plan.</rdfs:comment>
        <skos:definition>A kind of intended course of action set out in advance: roadmap, contingency plan, production schedule.</skos:definition>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
        <skos:topConceptOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#Classification">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>Classification</rdfs:label>
        <skos:prefLabel xml:lang="en">Classification</skos:prefLabel>
        <rdfs:comment>A category, stage or class within an established classification scheme. Examples: trial phase (Phase 1-3), therapeutic area, drug modality, transport mode.</rdfs:comment>
        <skos:definition>A kind of category, stage or class in an established scheme: trial phase, therapeutic area, transport mode.</skos:definition>
        <skos:scopeNote xml:lang="en">A label for where something sits in a scheme, not an activity: Phase 3 is a Classification; running the Phase 3 trial is a ClinicalTrial (Process).</skos:scopeNote>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
        <skos:topConceptOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#InformationArtifact">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="http://xmlns.com/foaf/0.1/Document"/>
        <rdfs:label>InformationArtifact</rdfs:label>
        <skos:prefLabel xml:lang="en">Information artifact</skos:prefLabel>
        <rdfs:comment>A document or body of recorded information, as a kind. Examples: reporting documents, drug labels, bills of materials. A kind of foaf:Document (reused from FOAF, which is always merged); distinct from viao:Document, the corpus file.</rdfs:comment>
        <skos:definition>A kind of document or recorded information an organization produces or relies on: reports, labels, bills of materials.</skos:definition>
        <skos:scopeNote xml:lang="en">The kind of document. A specific filed document (Tesla's 2023 10-K) is an instance; the corpus files themselves are viao:Document.</skos:scopeNote>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
        <skos:topConceptOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#ReportingDocument">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#InformationArtifact"/>
        <rdfs:label>ReportingDocument</rdfs:label>
        <skos:prefLabel xml:lang="en">Reporting document</skos:prefLabel>
        <rdfs:comment>A formal document an organization publishes to report on its finances or operations. Examples: financial statements, audit report, quarterly results, annual report.</rdfs:comment>
        <skos:definition>A kind of formal document an organization publishes to report on itself: financial statements, audit report, quarterly results.</skos:definition>
        <skos:scopeNote xml:lang="en">The document kind. The release event (publishing results) is an EarningsRelease; the figures in it are Measures.</skos:scopeNote>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
    </owl:Class>

    <!-- ===== Table anchors ===== -->
    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#FinancialTable">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>FinancialTable</rdfs:label>
        <skos:prefLabel xml:lang="en">Financial table</skos:prefLabel>
        <rdfs:comment>A table of financial values extracted from a source document. Examples: revenue tables, balance sheet tables, segment tables.</rdfs:comment>
        <skos:definition>A table of financial values extracted from a source document; parent class for newly minted table-type subclasses.</skos:definition>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
        <skos:topConceptOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#FinancialObservation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>FinancialObservation</rdfs:label>
        <skos:prefLabel xml:lang="en">Financial observation</skos:prefLabel>
        <rdfs:comment>A factual statement read from a financial table cell (e.g. "FY2024 automotive revenue = USD 78.4B"). Each observation keeps its context: the reporting entity, the concept measured, the period, the unit and scale, and the source table and page. Distinct from the generic predicates (hasMetric etc.), which link an entity to a KIND of quantity, not to a value.</rdfs:comment>
        <skos:definition>A factual reading from a row and column intersection in a FinancialTable, carrying its entity, concept, period, unit and source.</skos:definition>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
        <skos:topConceptOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#Dimension">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>Dimension</rdfs:label>
        <skos:prefLabel xml:lang="en">Dimension</skos:prefLabel>
        <rdfs:comment>A categorical or qualitative axis used to slice a metric or measure (e.g. Segment, Geography, Period, Product line).</rdfs:comment>
        <skos:definition>A categorical axis along which metrics and measures are sliced.</skos:definition>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
        <skos:topConceptOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#TimePeriod">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:label>TimePeriod</rdfs:label>
        <skos:prefLabel xml:lang="en">Time period</skos:prefLabel>
        <rdfs:comment>A bounded interval of time used as a slicing axis on financial reports (e.g. FY2024, Q1 2024, first half of 2023).</rdfs:comment>
        <skos:definition>A bounded reporting interval used as a slicing axis on financial tables.</skos:definition>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
        <skos:topConceptOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
    </owl:Class>

    <!-- ===== Finance ===== -->
    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#Revenue">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#Measure"/>
        <rdfs:label>Revenue</rdfs:label>
        <skos:prefLabel xml:lang="en">Revenue</skos:prefLabel>
        <rdfs:comment>Income from an organization's ordinary activities over a period, before costs.</rdfs:comment>
        <skos:definition>Income from an organization's ordinary activities over a period, before costs.</skos:definition>
        <skos:scopeNote xml:lang="en">'Turnover' means revenue in UK/IFRS reporting, but also staff turnover or inventory turnover; read it as revenue only in a financial context.</skos:scopeNote>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
        <skos:related rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#Sales"/>
        <inConceptArea rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#FinancialPerformance"/>
        <conceptTerm>revenue</conceptTerm>
        <conceptTerm>revenues</conceptTerm>
        <conceptTerm>total revenue</conceptTerm>
        <conceptTerm>net revenue</conceptTerm>
        <conceptTerm>turnover</conceptTerm>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#Sales">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#Measure"/>
        <rdfs:label>Sales</rdfs:label>
        <skos:prefLabel xml:lang="en">Sales</skos:prefLabel>
        <rdfs:comment>The value or volume of goods and services sold over a period.</rdfs:comment>
        <skos:definition>The value or volume of goods and services sold over a period.</skos:definition>
        <skos:scopeNote xml:lang="en">Often reported as the main revenue line; keep it distinct from Revenue when a report shows both.</skos:scopeNote>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
        <skos:related rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#Revenue"/>
        <inConceptArea rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#FinancialPerformance"/>
        <conceptTerm>sales</conceptTerm>
        <conceptTerm>net sales</conceptTerm>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#Cost">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#Measure"/>
        <rdfs:label>Cost</rdfs:label>
        <skos:prefLabel xml:lang="en">Cost</skos:prefLabel>
        <rdfs:comment>An amount spent or incurred to produce or deliver something.</rdfs:comment>
        <skos:definition>An amount spent or incurred to produce or deliver something.</skos:definition>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
        <inConceptArea rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#FinancialPerformance"/>
        <conceptTerm>cost</conceptTerm>
        <conceptTerm>costs</conceptTerm>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#CostOfGoodsSold">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#Cost"/>
        <rdfs:label>CostOfGoodsSold</rdfs:label>
        <skos:prefLabel xml:lang="en">Cost of goods sold</skos:prefLabel>
        <skos:altLabel xml:lang="en">COGS</skos:altLabel>
        <skos:altLabel xml:lang="en">cost of sales</skos:altLabel>
        <rdfs:comment>The direct cost of the goods an organization sold in a period.</rdfs:comment>
        <skos:definition>The direct cost of the goods an organization sold in a period.</skos:definition>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
        <inConceptArea rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#FinancialPerformance"/>
        <inConceptArea rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#ManufacturingCosts"/>
        <conceptTerm>cost of goods sold</conceptTerm>
        <conceptTerm>cogs</conceptTerm>
        <conceptTerm>cost of sales</conceptTerm>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#Expense">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#Measure"/>
        <rdfs:label>Expense</rdfs:label>
        <skos:prefLabel xml:lang="en">Expense</skos:prefLabel>
        <rdfs:comment>A cost recognized in the income statement for a period.</rdfs:comment>
        <skos:definition>A cost recognized in the income statement for a period.</skos:definition>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
        <inConceptArea rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#FinancialPerformance"/>
        <conceptTerm>expense</conceptTerm>
        <conceptTerm>expenses</conceptTerm>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#OperatingExpense">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#Expense"/>
        <rdfs:label>OperatingExpense</rdfs:label>
        <skos:prefLabel xml:lang="en">Operating expense</skos:prefLabel>
        <skos:altLabel xml:lang="en">opex</skos:altLabel>
        <skos:altLabel xml:lang="en">operating expenditure</skos:altLabel>
        <rdfs:comment>An expense of running the business, excluding cost of goods sold, interest and tax.</rdfs:comment>
        <skos:definition>An expense of running the business, excluding cost of goods sold, interest and tax.</skos:definition>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
        <inConceptArea rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#FinancialPerformance"/>
        <conceptTerm>operating expense</conceptTerm>
        <conceptTerm>operating expenses</conceptTerm>
        <conceptTerm>opex</conceptTerm>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#Profit">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#Measure"/>
        <rdfs:label>Profit</rdfs:label>
        <skos:prefLabel xml:lang="en">Profit</skos:prefLabel>
        <rdfs:comment>An amount left after deducting some costs from revenue; the grouping of the profit measures.</rdfs:comment>
        <skos:definition>An amount left after deducting some costs from revenue; the grouping of the profit measures.</skos:definition>
        <skos:scopeNote xml:lang="en">A grouping: gross profit, operating profit and net income are different quantities under it. 'Earnings' usually means net income but is read here only as the grouping.</skos:scopeNote>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
        <inConceptArea rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#FinancialPerformance"/>
        <conceptTerm>profit</conceptTerm>
        <conceptTerm>profits</conceptTerm>
        <conceptTerm>earnings</conceptTerm>
        <conceptTerm>bottom line</conceptTerm>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#GrossProfit">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#Profit"/>
        <rdfs:label>GrossProfit</rdfs:label>
        <skos:prefLabel xml:lang="en">Gross profit</skos:prefLabel>
        <rdfs:comment>Revenue minus cost of goods sold.</rdfs:comment>
        <skos:definition>Revenue minus cost of goods sold.</skos:definition>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
        <skos:related rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#GrossMargin"/>
        <inConceptArea rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#FinancialPerformance"/>
        <conceptTerm>gross profit</conceptTerm>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#OperatingProfit">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#Profit"/>
        <rdfs:label>OperatingProfit</rdfs:label>
        <skos:prefLabel xml:lang="en">Operating profit</skos:prefLabel>
        <skos:altLabel xml:lang="en">operating income</skos:altLabel>
        <rdfs:comment>Gross profit minus operating expenses: profit from operations before interest and tax.</rdfs:comment>
        <skos:definition>Gross profit minus operating expenses: profit from operations before interest and tax.</skos:definition>
        <skos:scopeNote xml:lang="en">Close to EBIT but not always equal; EBIT can include non-operating items.</skos:scopeNote>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
        <skos:related rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#OperatingMargin"/>
        <inConceptArea rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#FinancialPerformance"/>
        <conceptTerm>operating profit</conceptTerm>
        <conceptTerm>operating income</conceptTerm>
        <conceptTerm>operating loss</conceptTerm>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#NetIncome">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#Profit"/>
        <rdfs:label>NetIncome</rdfs:label>
        <skos:prefLabel xml:lang="en">Net income</skos:prefLabel>
        <skos:altLabel xml:lang="en">net profit</skos:altLabel>
        <skos:altLabel xml:lang="en">net earnings</skos:altLabel>
        <rdfs:comment>Profit after all costs, interest and taxes for a period.</rdfs:comment>
        <skos:definition>Profit after all costs, interest and taxes for a period.</skos:definition>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
        <inConceptArea rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#FinancialPerformance"/>
        <conceptTerm>net income</conceptTerm>
        <conceptTerm>net profit</conceptTerm>
        <conceptTerm>net loss</conceptTerm>
        <conceptTerm>net earnings</conceptTerm>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#Margin">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#Metric"/>
        <rdfs:label>Margin</rdfs:label>
        <skos:prefLabel xml:lang="en">Margin</skos:prefLabel>
        <rdfs:comment>A profit measure expressed as a share of revenue; the grouping of the margin metrics.</rdfs:comment>
        <skos:definition>A profit measure expressed as a share of revenue; the grouping of the margin metrics.</skos:definition>
        <skos:scopeNote xml:lang="en">A grouping: gross margin and operating margin are different metrics. 'Margin' also means collateral (trading) or a price markup; read it as a profit ratio only in a financial-performance context.</skos:scopeNote>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
        <inConceptArea rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#FinancialPerformance"/>
        <conceptTerm>margin</conceptTerm>
        <conceptTerm>margins</conceptTerm>
        <conceptTerm>profit margin</conceptTerm>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#GrossMargin">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#Margin"/>
        <rdfs:label>GrossMargin</rdfs:label>
        <skos:prefLabel xml:lang="en">Gross margin</skos:prefLabel>
        <skos:altLabel xml:lang="en">gross profit margin</skos:altLabel>
        <rdfs:comment>Gross profit as a percentage of revenue.</rdfs:comment>
        <skos:definition>Gross profit as a percentage of revenue.</skos:definition>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
        <inConceptArea rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#FinancialPerformance"/>
        <conceptTerm>gross margin</conceptTerm>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#OperatingMargin">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#Margin"/>
        <rdfs:label>OperatingMargin</rdfs:label>
        <skos:prefLabel xml:lang="en">Operating margin</skos:prefLabel>
        <skos:altLabel xml:lang="en">operating profit margin</skos:altLabel>
        <rdfs:comment>Operating profit as a percentage of revenue.</rdfs:comment>
        <skos:definition>Operating profit as a percentage of revenue.</skos:definition>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
        <inConceptArea rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#FinancialPerformance"/>
        <conceptTerm>operating margin</conceptTerm>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#EarningsPerShare">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#Metric"/>
        <rdfs:label>EarningsPerShare</rdfs:label>
        <skos:prefLabel xml:lang="en">Earnings per share</skos:prefLabel>
        <skos:altLabel xml:lang="en">EPS</skos:altLabel>
        <rdfs:comment>Net income attributable to shareholders divided by the number of shares.</rdfs:comment>
        <skos:definition>Net income attributable to shareholders divided by the number of shares.</skos:definition>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
        <inConceptArea rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#FinancialPerformance"/>
        <conceptTerm>earnings per share</conceptTerm>
        <conceptTerm>eps</conceptTerm>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#Assets">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#Measure"/>
        <rdfs:label>Assets</rdfs:label>
        <skos:prefLabel xml:lang="en">Assets</skos:prefLabel>
        <rdfs:comment>The reported value of what an organization owns, as carried on its balance sheet.</rdfs:comment>
        <skos:definition>The reported value of what an organization owns, as carried on its balance sheet.</skos:definition>
        <skos:scopeNote xml:lang="en">The amount. A single resource an organization owns is an Asset.</skos:scopeNote>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
        <skos:related rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#Asset"/>
        <inConceptArea rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#FinancialPosition"/>
        <conceptTerm>assets</conceptTerm>
        <conceptTerm>total assets</conceptTerm>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#Asset">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#EconomicConcept"/>
        <rdfs:label>Asset</rdfs:label>
        <skos:prefLabel xml:lang="en">Asset</skos:prefLabel>
        <rdfs:comment>A resource an organization controls and expects economic benefit from: a plant, a receivable, a patent.</rdfs:comment>
        <skos:definition>A resource an organization controls and expects economic benefit from: a plant, a receivable, a patent.</skos:definition>
        <skos:scopeNote xml:lang="en">The resource itself, not its reported value (Assets).</skos:scopeNote>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
        <skos:related rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#Assets"/>
        <inConceptArea rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#FinancialPosition"/>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#Liabilities">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#Measure"/>
        <rdfs:label>Liabilities</rdfs:label>
        <skos:prefLabel xml:lang="en">Liabilities</skos:prefLabel>
        <rdfs:comment>The reported value of what an organization owes.</rdfs:comment>
        <skos:definition>The reported value of what an organization owes.</skos:definition>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
        <inConceptArea rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#FinancialPosition"/>
        <conceptTerm>liabilities</conceptTerm>
        <conceptTerm>total liabilities</conceptTerm>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#Equity">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#Measure"/>
        <rdfs:label>Equity</rdfs:label>
        <skos:prefLabel xml:lang="en">Equity</skos:prefLabel>
        <skos:altLabel xml:lang="en">shareholders' equity</skos:altLabel>
        <skos:altLabel xml:lang="en">stockholders' equity</skos:altLabel>
        <skos:altLabel xml:lang="en">total equity</skos:altLabel>
        <rdfs:comment>The owners' residual interest: assets minus liabilities, as reported.</rdfs:comment>
        <skos:definition>The owners' residual interest: assets minus liabilities, as reported.</skos:definition>
        <skos:scopeNote xml:lang="en">'Equity' also means shares as an instrument (Share) or an equity stake; read it as the balance-sheet amount only in a financial-position context.</skos:scopeNote>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
        <inConceptArea rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#FinancialPosition"/>
        <conceptTerm>equity</conceptTerm>
        <conceptTerm>shareholders equity</conceptTerm>
        <conceptTerm>shareholders' equity</conceptTerm>
        <conceptTerm>total equity</conceptTerm>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#Cash">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#Measure"/>
        <rdfs:label>Cash</rdfs:label>
        <skos:prefLabel xml:lang="en">Cash</skos:prefLabel>
        <skos:altLabel xml:lang="en">cash and cash equivalents</skos:altLabel>
        <rdfs:comment>Cash and cash equivalents held at a date.</rdfs:comment>
        <skos:definition>Cash and cash equivalents held at a date.</skos:definition>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
        <inConceptArea rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#FinancialPosition"/>
        <inConceptArea rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#WorkingCapitalManagement"/>
        <conceptTerm>cash</conceptTerm>
        <conceptTerm>cash and cash equivalents</conceptTerm>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#Debt">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#EconomicConcept"/>
        <rdfs:label>Debt</rdfs:label>
        <skos:prefLabel xml:lang="en">Debt</skos:prefLabel>
        <rdfs:comment>An obligation to repay borrowed money: loans, bonds, debentures.</rdfs:comment>
        <skos:definition>An obligation to repay borrowed money: loans, bonds, debentures.</skos:definition>
        <skos:scopeNote xml:lang="en">The obligation. The amount outstanding at a date is DebtBalance.</skos:scopeNote>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
        <skos:related rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DebtBalance"/>
        <inConceptArea rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#FinancialPosition"/>
        <inConceptArea rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#FinancingAndCapitalManagement"/>
        <conceptTerm>debt</conceptTerm>
        <conceptTerm>borrowings</conceptTerm>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#DebtBalance">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#Measure"/>
        <rdfs:label>DebtBalance</rdfs:label>
        <skos:prefLabel xml:lang="en">Debt balance</skos:prefLabel>
        <skos:altLabel xml:lang="en">total debt</skos:altLabel>
        <rdfs:comment>The amount of debt outstanding at a date.</rdfs:comment>
        <skos:definition>The amount of debt outstanding at a date.</skos:definition>
        <skos:scopeNote xml:lang="en">Net debt (debt minus cash) is reported separately by many companies; it routes here but is not a synonym.</skos:scopeNote>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
        <skos:related rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#Debt"/>
        <inConceptArea rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#FinancialPosition"/>
        <inConceptArea rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#FinancingAndCapitalManagement"/>
        <conceptTerm>debt balance</conceptTerm>
        <conceptTerm>total debt</conceptTerm>
        <conceptTerm>net debt</conceptTerm>
        <conceptTerm>outstanding debt</conceptTerm>
    </owl:Class>

    <owl:Class rdf:about="https://veerla-ramrao.ai/ontology/domain-concepts#OperatingCashFlow">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
