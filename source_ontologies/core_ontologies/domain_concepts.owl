        <skos:scopeNote xml:lang="en">Includes: disruptions, supplier concentration, single and sole sourcing, contingency plans, alternative sourcing. Excludes: financial risk (FinancialRisk).</skos:scopeNote>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#ConceptAreaScheme"/>
        <skos:broader rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#SupplyChainManagement"/>
        <skos:related rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#Sourcing"/>
        <conceptTerm>supply chain risk</conceptTerm>
        <conceptTerm>supply chain resilience</conceptTerm>
        <conceptTerm>supply risk</conceptTerm>
    </owl:Class>

