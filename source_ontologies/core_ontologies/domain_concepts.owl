        <skos:prefLabel xml:lang="en">Sole sourcing</skos:prefLabel>
        <rdfs:comment>Buying an input from the only supplier able to provide it.</rdfs:comment>
        <skos:definition>Buying an input from the only supplier able to provide it.</skos:definition>
        <skos:scopeNote xml:lang="en">No alternative exists; when alternatives exist but are not used it is SingleSourcing.</skos:scopeNote>
        <skos:inScheme rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#DomainConceptsScheme"/>
        <skos:related rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#SingleSourcing"/>
        <inConceptArea rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#Sourcing"/>
        <inConceptArea rdf:resource="https://veerla-ramrao.ai/ontology/domain-concepts#SupplyChainRiskAndResilience"/>
        <conceptTerm>sole sourcing</conceptTerm>
        <conceptTerm>sole source</conceptTerm>
        <conceptTerm>sole supplier</conceptTerm>
    </owl:Class>

