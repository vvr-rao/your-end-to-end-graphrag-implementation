# Ontology folders: keep top-level (notes.md tracked) but ignore subdirectories where actual .owl content lives
source_ontologies/*/
# Whitelist core_ontologies/ specifically (user-curated core ontologies meant to ship with the repo).
!source_ontologies/core_ontologies/
!source_ontologies/core_ontologies/**
# Vendor the OCRe + FIBO domain zips so a fresh clone can build the pharma/finance
# domains: OCRe cannot be auto-downloaded (upstream Google Code is dead; PURL ->
# BioPortal needs an API key), and FIBO is vendored as a fallback in case the live
# download is unavailable. Track ONLY these specific zips -- the pattern un-ignores
# each dir, re-ignores its contents, then un-ignores the one zip, so the huge raw
# neighbours (pharma_ontologies/dron.owl 670M, hp.owl 73M) stay ignored. OntoCAPE
# is intentionally NOT vendored (GPL + RWTH form-gated) -- users supply it themselves.
!source_ontologies/pharma_ontologies/
source_ontologies/pharma_ontologies/*
!source_ontologies/pharma_ontologies/OCRe.zip
!source_ontologies/finance_ontologies/
source_ontologies/finance_ontologies/*
!source_ontologies/finance_ontologies/prod.rdf.zip
output_ontologies/*/

# Source documents: only the top-level notes.md + the bundled downloader
# CLIs are tracked; everything else (user-supplied PDFs/TXTs, per-tool
# output folders) is ignored.
source_documents/*
!source_documents/notes.md
!source_documents/.gitkeep
!source_documents/_downloader_common.py
!source_documents/dailymed_download.py
!source_documents/websearch_download.py
!source_documents/financial_report_download.py

# User-supplied class suggestions are local config (domain-specific hints).
# Repo ships a *.example.json template; the real file is gitignored.
suggested_new_classes.json

# Eval question sets are corpus-specific. Repo ships *.example.txt templates;
# users copy them to a local .txt file (gitignored) before editing.
eval_questions/*.txt
!eval_questions/*.example.txt

# Reference materials (notebooks, scratch) — local-only, not part of source code
reference/

# Durable-run harness working dir: per-job logs + status for detached CLI runs
# (scripts/run_detached.sh). Machine-local run state, never committed.
.runs/

# Per-user build-progress tracker (cross-session state; not repo content)
.build/

# Claude Code writes settings.local.json atomically; the temp files are not artifacts
.claude/settings.local.json.tmp.*

# ad-hoc scratch scripts at the repo root (real tools live in scripts/)
/_*.py

# Audit reports + query-run outputs: local working notes, not repo content
docs/

# Session scratch dir if one is created at the repo root
.scratchpad/
